generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model void_users {
  id       String  @id @default(uuid())
  email    String  @unique @db.VarChar(250)
  username String  @db.VarChar(16)
  password String  @db.VarChar(255)
  hwid     String? @unique @db.VarChar(250)
  banned   Boolean @default(false)

  configs void_module_config[]
}

model void_module_config {
  id         String     @id @default(uuid())
  user_id    String
  user       void_users @relation(fields: [user_id], references: [id], onDelete: Cascade)
  module     String
  action     String
  settings   Json
  conditions Json       @default("[]")

  @@unique([user_id, module])
}
