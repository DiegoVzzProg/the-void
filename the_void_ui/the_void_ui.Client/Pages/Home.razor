@page "/"

@using the_void_ui.Client.Models
@using the_void_ui.Client.Services
@inject ModulosService ModulosService 


@using System.Text.Json

<PageTitle>Home</PageTitle>

<style>
    .void-container {
        display: flex;
        flex-direction: row;

        width: 100%;
        height: 100dvh;
    }

    .void--nav-1 {
        width: 100%;
        max-width: 320px;
        
        display: flex;
        flex-direction: column;

        height: 100%;
        background-color: #12141C;
        border-right: 1px solid #232732;

        padding: clamp(18px, 3vw, 28px);

        gap: 50px;
    }

        .void--nav-1 .void--div-section-1 {
            width: 100%;
            display: flex;
            flex-direction:column;
            justify-items: center;

            transform: translateX(14px);
        }

        .void--nav-1 .void--div-section-modules {
            width: 100%;
            height: 100%;

            display: flex;
            flex-direction: column;

            gap:3px;
        }

        .void--div-section-modules .void-btn-module {
                color: #64748B;
                background-color: transparent;
                border: none;

                display: flex;
                align-items: center;
                gap: 8px;

                border-radius: 14px;
                padding: 14px;

                transition: all .3s;
        }

    .void-btn-module:hover {
        background-color: #232732;
        color: white;
    }

    .void-btn-module.void-btn-module--active {
        background-color: rgba(99, 102, 241, .2);
        color: #6366F1;
    }

    .void--nav-2 {
        display: flex;
        justify-content: flex-end;

        align-items: center;

        width: 100%;
        height: 84px;
        background-color: #12141C;
        border-bottom: 1px solid #232732;

        padding-inline: 24px;
    }

    .void--status-user {
        padding: 14px;
        border-radius: 20px;
        border: 1px solid #232732;
        width: 100%;
        max-width: 180px;
        background-color: #0B0C10;

        display: flex;
        flex-direction: column;

        align-items: flex-start;
    }

    .void--container-destroyer {
        display: flex;
        align-items: center;

        width: 100%;
    }

    .void-btn-destroyer {
        width: 100%;
        padding: 12px;
        border-radius: 18px;
        background-color: rgba(251, 44, 54, .2);
        border: 1px solid rgb(251, 44, 54);

        opacity: .7;

        transition: all .3s;
    }

    .void-btn-destroyer:hover{
        opacity: 1;
    }
</style>

<style>
    /* From Uiverse.io by Shoh2008 */
    .loader {
        display: flex;
        justify-content: flex-start;
        width: 100%;
        height: 12px;
        position: relative;
    }

        .loader:before, .loader:after {
            content: "";
            position: absolute;
            bottom: 0;
            width: 12px;
            height: 12px;
            border-radius: 50%;
            left: 5px;
            background: #1c1c;
            transform: translate(-50%, -100%) scale(0);
            animation: push_401 2s infinite linear;
        }

        .loader:after {
            animation-delay: 1s;
        }

    @@keyframes push_401 {
        0%, 50% {
            transform: translate(-50%, 0%) scale(1)
        }

        100% {
            transform: translate(-50%, -100%) scale(0)
        }

    }
</style>

